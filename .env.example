
APP_NAME=Adaptive Web Crawler
APP_VERSION=0.1.0
APP_ENV=development

# Neon PostgreSQL - Pooled Connection
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Neon PostgreSQL - Direct Connection (Alembic)
DIRECT_URL=postgresql+psycopg://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require

MAX_CONCURRENCY=3
REQUEST_TIMEOUT=30
MAX_RETRIES=3

DEFAULT_FETCHER=fetcher
ROBOTS_TXT_OBEY=true
